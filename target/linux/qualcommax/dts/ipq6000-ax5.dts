/dts-v1/;

#include "ipq6018.dtsi"
#include "ipq6018-cp-cpu.dtsi"
#include "ipq6018-ess.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	model = "Redmi AX5";
	compatible = "redmi,ax5", "qcom,ipq6018";
	qcom,msm-id = <0x192 0x0>;

	aliases {
		serial0 = &blsp1_uart3;

		led-boot = &led_system_yellow;
		led-failsafe = &led_system_blue;
		led-running = &led_system_blue;
		led-upgrade = &led_system_yellow;

		ethernet1 = &swport2;
		ethernet2 = &swport3;
		ethernet3 = &swport4;
		ethernet4 = &swport5;

		label-mac-device = &swport5;
	};

	chosen {
		stdout-path = "serial0:115200n8";
		bootargs-append = " root=/dev/ubiblock0_1 swiotlb=1 coherent_pool=512K";
	};

	keys {
		compatible = "gpio-keys";

		reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&tlmm 19 GPIO_ACTIVE_LOW>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led_system_blue: system-blue {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_STATUS;
			gpios = <&tlmm 29 GPIO_ACTIVE_HIGH>;
		};

		led_system_yellow: system-yellow {
			color = <LED_COLOR_ID_YELLOW>;
			function = LED_FUNCTION_STATUS;
			gpios = <&tlmm 30 GPIO_ACTIVE_HIGH>;
		};

		led_network_blue: network-blue {
			color = <LED_COLOR_ID_BLUE>;
			function = "network";
			gpios = <&tlmm 31 GPIO_ACTIVE_HIGH>;
		};

		led_network_yellow: network-yellow {
			color = <LED_COLOR_ID_YELLOW>;
			function = "network";
			gpios = <&tlmm 32 GPIO_ACTIVE_HIGH>;
		};
	};
};

&tlmm {
	mdio_pins: mdio-pins {
		mdc {
			pins = "gpio64";
			function = "mdc";
			drive-strength = <8>;
			bias-pull-up;
		};

		mdio {
			pins = "gpio65";
			function = "mdio";
			drive-strength = <8>;
			bias-pull-up;
		};
	};
};

&blsp1_uart3 {
	status = "okay";
	pinctrl-0 = <&serial_3_pins>;
	pinctrl-names = "default";
};

&qpic_bam {
	status = "okay";
};

&qpic_nand {
	status = "okay";

	nand@0 {
		reg = <0>;
		nand-ecc-strength = <4>;
		nand-ecc-step-size = <512>;
		nand-bus-width = <8>;

		partitions {
			compatible = "qcom,smem-part";

			partition-0-art {
				label = "0:art";
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					lanaddr: macaddr@6 {
						reg = <0x6 0x6>;
					};

					wanaddr: macaddr@18 {
						reg = <0x18 0x6>;
					};

					caldata: caldata@1000 {
						reg = <0x1000 0x10000>;
					};
				};
			};
		};
	};
};

&wifi {
	status = "okay";
	/*
	 * Mode 2, as stock (qcom,tgt-mem-mode = <2>): the 256 MiB profile,
	 * which caps the firmware at 8 VDEVs and 128 peers.
	 */
	qcom,ath11k-fw-memory-mode = <2>;
	qcom,calibration-variant = "Redmi-AX5";
	nvmem-cells = <&caldata>;
	nvmem-cell-names = "calibration";
};

&mdio {
	status = "okay";

	pinctrl-0 = <&mdio_pins>;
	pinctrl-names = "default";
	reset-gpios = <&tlmm 75 GPIO_ACTIVE_LOW>;

	ethernet-phy-package@0 {
		compatible = "qcom,qca8075-package";
		qcom,package-mode = "psgmii";
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <0>;

		qca8075_1: ethernet-phy@1 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <1>;
		};

		qca8075_2: ethernet-phy@2 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <2>;
		};

		qca8075_3: ethernet-phy@3 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <3>;
		};

		qca8075_4: ethernet-phy@4 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <4>;
		};
	};
};

&uniphy0 {
	status = "okay";
};

&switch {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			ethernet = <&edma>;
			phy-mode = "internal";

			fixed-link {
				speed = <1000>;
				full-duplex;
			};
		};

		swport2: port@2 {
			reg = <2>;
			label = "lan1";
			phy-handle = <&qca8075_1>;
			phy-mode = "psgmii";
			pcs-handle = <&uniphy0 1>;
			nvmem-cells = <&lanaddr>;
			nvmem-cell-names = "mac-address";
		};

		swport3: port@3 {
			reg = <3>;
			label = "lan2";
			phy-handle = <&qca8075_2>;
			phy-mode = "psgmii";
			pcs-handle = <&uniphy0 2>;
			nvmem-cells = <&lanaddr>;
			nvmem-cell-names = "mac-address";
		};

		swport4: port@4 {
			reg = <4>;
			label = "lan3";
			phy-handle = <&qca8075_3>;
			phy-mode = "psgmii";
			pcs-handle = <&uniphy0 3>;
			nvmem-cells = <&lanaddr>;
			nvmem-cell-names = "mac-address";
		};

		swport5: port@5 {
			reg = <5>;
			label = "wan";
			phy-handle = <&qca8075_4>;
			phy-mode = "psgmii";
			pcs-handle = <&uniphy0 4>;
			nvmem-cells = <&wanaddr>;
			nvmem-cell-names = "mac-address";
		};
	};
};

&edma {
	status = "okay";
};

/*
 * The reserved-memory layout follows the stock firmware's 256 MiB
 * profile. NSS is unused, but the region stays reserved: dropping it
 * makes the device unstable. 8 MiB is the size stock uses here, half
 * of what the ipq6018 NSS patch reserves.
 */
&nss_region {
	reg = <0x0 0x40000000 0x0 0x00800000>;
};

/* Stock uses the bootloader range as RAM as well: recover 4 MiB. */
&{/reserved-memory} {
	/delete-node/ bootloader@4a100000;
};

/*
 * 40 MiB, as stock (wcnss@4ab00000). The firmware in memory mode 2
 * asks for 39.25 MiB. The default 85 MiB would run to the top of RAM.
 */
&q6_region {
	reg = <0x0 0x4ab00000 0x0 0x02800000>;
};

/*
 * The Q6 ETR and M3 dump buffers, at the addresses stock reserves for
 * them right after the Q6 region. The ipq6018 dtsi does not carry them.
 */
/ {
	reserved-memory {
		q6_etr_dump@4d300000 {
			reg = <0x0 0x4d300000 0x0 0x100000>;
			no-map;
		};

		m3_dump@4d400000 {
			reg = <0x0 0x4d400000 0x0 0x100000>;
			no-map;
		};
	};
};
