From: Andrew Sim <andrewsimz@gmail.com>
Subject: [PATCH] wifi: ath11k: add a 256 MiB memory profile

ath11k sizes its datapath rings for devices with 1 GiB of RAM or more,
which leaves too little memory on 256 MiB IPQ6018/IPQ6000 boards.

Add ATH11K_MEM_PROFILE_256M, which uses the ring sizes Qualcomm's QSDK
ships for QCA6018 (ini/internal/QCA6018_i.ini) on such a board, the
Xiaomi Redmi AX5:

  RXDMA buffer ring             4096 -> 1024
  monitor status ring           1024 -> 512
  monitor buffer ring           4096 -> 128
  monitor destination ring      2048 -> 128
  REO status ring               2048 -> 1024
  monitor descriptor ring       4096 -> 128

The rings that hold buffers, the RXDMA buffer and monitor rings, get
much smaller; the others only hold descriptors. The TX completion ring
(32768) and the REO destination rings (2048) already match QSDK.

QSDK also raises the RXDMA error destination and RX release rings from
1024 to 4096. They only carry error and exception frames, and the
512 MiB boards in OpenWrt run with 1024, so they keep the ath11k
defaults.

The monitor descriptor ring is the one exception: QSDK keeps 4096, but
it is only used in monitor mode, and as IPQ6018 sets rxdma1_enable it
is set up on every radio with one 128-byte link descriptor per entry,
about 512 KiB each. 128 entries, as in the 256 MiB profile of
kuncy7/openwrt-nss-edma, cost about 16 KiB.

DP_RXDMA_REFILL_RING_SIZE stays at 2048: despite its name it is the
rx_buf_size handed to the firmware, not a ring size. The firmware
memory mode and the VDEV/peer limits are left to the existing
qcom,ath11k-fw-memory-mode device tree property.

Signed-off-by: Andrew Sim <andrewsimz@gmail.com>
---
 drivers/net/wireless/ath/ath11k/Kconfig | 11 +++++++++++
 drivers/net/wireless/ath/ath11k/dp.h    | 21 +++++++++++++++++++--
 local-symbols                           |  1 +
 3 files changed, 31 insertions(+), 2 deletions(-)

--- a/drivers/net/wireless/ath/ath11k/Kconfig
+++ b/drivers/net/wireless/ath/ath11k/Kconfig
@@ -79,3 +79,14 @@ config ATH11K_CFR
 	  to enable, disable, and dump data.
 
 	  Say Y to enable CFR data dump collection via debugfs.
+
+config ATH11K_MEM_PROFILE_256M
+	bool "Datapath ring sizes for 256 MiB devices"
+	depends on ATH11K
+	help
+	  Use the datapath ring sizes of Qualcomm's QSDK for QCA6018 instead
+	  of the defaults, which are sized for devices with 1 GiB of RAM.
+	  The RXDMA buffer and monitor rings, which hold buffers, are much
+	  smaller.
+
+	  If unsure, say N.
--- a/drivers/net/wireless/ath/ath11k/dp.h
+++ b/drivers/net/wireless/ath/ath11k/dp.h
@@ -217,14 +217,31 @@ struct ath11k_pdev_dp {
 #define DP_RX_RELEASE_RING_SIZE		1024
 #define DP_REO_EXCEPTION_RING_SIZE	128
 #define DP_REO_CMD_RING_SIZE		256
-#define DP_REO_STATUS_RING_SIZE		2048
-#define DP_RXDMA_BUF_RING_SIZE		4096
+/*
+ * DP_RXDMA_REFILL_RING_SIZE is not a ring size but the rx_buf_size passed
+ * to the firmware, so it does not change with the memory profile.
+ */
 #define DP_RXDMA_REFILL_RING_SIZE	2048
 #define DP_RXDMA_ERR_DST_RING_SIZE	1024
+#ifdef CPTCFG_ATH11K_MEM_PROFILE_256M
+/*
+ * The ring sizes of QSDK's QCA6018_i.ini, except for the monitor
+ * descriptor ring, which is only used in monitor mode.
+ */
+#define DP_REO_STATUS_RING_SIZE		1024
+#define DP_RXDMA_BUF_RING_SIZE		1024
+#define DP_RXDMA_MON_STATUS_RING_SIZE	512
+#define DP_RXDMA_MONITOR_BUF_RING_SIZE	128
+#define DP_RXDMA_MONITOR_DST_RING_SIZE	128
+#define DP_RXDMA_MONITOR_DESC_RING_SIZE	128
+#else
+#define DP_REO_STATUS_RING_SIZE		2048
+#define DP_RXDMA_BUF_RING_SIZE		4096
 #define DP_RXDMA_MON_STATUS_RING_SIZE	1024
 #define DP_RXDMA_MONITOR_BUF_RING_SIZE	4096
 #define DP_RXDMA_MONITOR_DST_RING_SIZE	2048
 #define DP_RXDMA_MONITOR_DESC_RING_SIZE	4096
+#endif
 
 #define DP_RX_RELEASE_RING_NUM	3
 
--- a/local-symbols
+++ b/local-symbols
@@ -165,6 +165,7 @@ ATH11K_TRACING=
 ATH11K_SPECTRAL=
 ATH11K_THERMAL=
 ATH11K_CFR=
+ATH11K_MEM_PROFILE_256M=
 ATH12K=
 ATH12K_AHB=
 ATH12K_DEBUG=
