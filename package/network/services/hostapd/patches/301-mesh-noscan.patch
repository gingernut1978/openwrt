From: Daniel Golle <daniel@makrotopia.org>
Date: Fri, 20 Apr 2018 07:41:03 +0200
Subject: [PATCH] Allow HT40 also on 2.4GHz if noscan option is set, which also
 skips secondary channel scan just like noscan works in AP mode.

--- a/wpa_supplicant/config.c
+++ b/wpa_supplicant/config.c
@@ -2882,6 +2882,7 @@ static const struct parse_data ssid_fiel
 #else /* CONFIG_MESH */
 	{ INT_RANGE(mode, 0, 4) },
 #endif /* CONFIG_MESH */
+	{ INT_RANGE(noscan, 0, 1) },
 	{ INT_RANGE(proactive_key_caching, 0, 1) },
 	{ INT_RANGE(disabled, 0, 2) },
 	{ STR(id_str) },
--- a/wpa_supplicant/config_file.c
+++ b/wpa_supplicant/config_file.c
@@ -910,6 +910,7 @@ static void wpa_config_write_network(FIL
 	INT(mode);
 #ifdef CONFIG_MESH
 	INT(no_auto_peer);
+	INT(noscan);
 	INT_DEF(mesh_fwding, DEFAULT_MESH_FWDING);
 #endif /* CONFIG_MESH */
 	INT(frequency);
--- a/wpa_supplicant/config_ssid.h
+++ b/wpa_supplicant/config_ssid.h
@@ -1075,6 +1075,8 @@ struct wpa_ssid {
 	 */
 	int no_auto_peer;
 
+	int noscan;
+
 	/**
 	 * mesh_rssi_threshold - Set mesh parameter mesh_rssi_threshold (dBm)
 	 *
--- a/wpa_supplicant/mesh.c
+++ b/wpa_supplicant/mesh.c
@@ -517,6 +517,8 @@ static int wpa_supplicant_mesh_init(stru
 			   frequency);
 		goto out_free;
 	}
+	if (conf->noscan)
+		ssid->noscan = 1;
 
 	if (ssid->mesh_basic_rates == NULL) {
 		/*
--- a/wpa_supplicant/wpa_supplicant.c
+++ b/wpa_supplicant/wpa_supplicant.c
@@ -3846,7 +3846,7 @@ static bool ibss_mesh_can_use_vht(struct
 				  const struct wpa_ssid *ssid,
 				  struct hostapd_hw_modes *mode)
 {
-	if (mode->mode != HOSTAPD_MODE_IEEE80211A)
+	if (mode->mode != HOSTAPD_MODE_IEEE80211A && !(ssid->noscan))
 		return false;
 
 	if (!drv_supports_vht(wpa_s, ssid))
@@ -3933,7 +3933,8 @@ static void ibss_mesh_select_40mhz(struc
 	static const int ht40plus_2g4[] = { 1, 2, 3, 4, 5, 6 };
 	int ht40 = -1;
 
-	if (is_24ghz) {
+	/* With noscan, HT40 is allowed in 2.4 GHz without HE */
+	if (is_24ghz && !ssid->noscan) {
 		if (!freq->he_enabled ||
 		    !(mode->he_capab[ieee80211_mode].phy_cap[
 			      HE_PHYCAP_CHANNEL_WIDTH_SET_IDX] &
@@ -4016,7 +4017,12 @@ static void ibss_mesh_select_40mhz(struc
 	}
 	freq->sec_channel_offset = ht40;
 
-	if (obss_scan || is_24ghz) {
+	if (is_24ghz && ssid->noscan) {
+		/* noscan skips the 20/40 MHz BSS coexistence check */
+		freq->bandwidth = 40;
+		freq->center_freq1 = freq->freq + freq->sec_channel_offset * 10;
+		freq->center_freq2 = 0;
+	} else if (obss_scan || is_24ghz) {
 		struct wpa_scan_results *scan_res;
 
 		scan_res = wpa_supplicant_get_scan_results(wpa_s, NULL, 0,
@@ -4320,7 +4326,7 @@ void ibss_mesh_setup_freq(struct wpa_sup
 	int ieee80211_mode = wpas_mode_to_ieee80211_mode(ssid->mode);
 	enum hostapd_hw_mode hw_mode;
 	struct hostapd_hw_modes *mode = NULL;
-	int obss_scan = 1;
+	int obss_scan = !(ssid->noscan);
 	u8 channel;
 	bool is_6ghz, is_24ghz;
 	bool dfs_enabled = wpa_s->conf->country[0] && (wpa_s->drv_flags & WPA_DRIVER_FLAGS_RADAR);
